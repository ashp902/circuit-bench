# Local development: the Next.js dev server proxies these same-origin paths.
LAB_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=

# Backend runtime
LAB_ENV=development
# Path is relative to the backend process working directory.
LAB_DB_PATH=./lab.db
LAB_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional: delete anonymous Labs after 30 days without activity at startup.
LAB_CLEANUP_INACTIVE_SESSIONS=false
NGSPICE_BIN=ngspice

# Production container defaults (set by Dockerfile; shown for clarity)
# LAB_ENV=production
# LAB_DB_PATH=/data/lab.db
# LAB_FRONTEND_DIR=/app/static
# LAB_CORS_ORIGINS=
# PORT=8000
